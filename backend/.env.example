# Securox Zero-Trust Government Security Portal - Environment Variables Template
# Copy to .env for local development

# Secret key for JWT signing (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=securox-gov-portal-super-secret-key-change-in-production-2026

# Database Connection (SQLite default, PostgreSQL ready: postgresql://user:pass@localhost:5432/securox_gov)
DATABASE_URL=sqlite:///./securox_gov.db

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Anomaly Detection Thresholds (Isolation Forest normalized score threshold)
ANOMALY_THRESHOLD=0.65
MAX_FAILED_LOGINS=4
API_RATE_LIMIT_PER_MIN=40

# Securox Correlation SIEM Engine Uplink URL
SECUROX_CORRELATION_URL=https://securox-engine.gov.internal/api/v1/events

